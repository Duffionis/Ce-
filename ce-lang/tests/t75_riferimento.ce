//> 11
//> 3
//> 30
struttura Conta { n: intero, tot: intero }
funzione incrementa(x: &intero) { x = x + 1; }
funzione somma_a(c: &Conta, v: intero) {
    c.n += 1;
    c.tot += v;
}
funzione principale() -> intero {
    variabile a: intero = 10;
    incrementa(a);
    stampa(a);
    variabile c: Conta = Conta { n: 0, tot: 0 };
    c.somma_a(10);
    c.somma_a(20);
    somma_a(c, 0);
    stampa(c.n);
    stampa(c.tot);
    ritorna 0;
}
