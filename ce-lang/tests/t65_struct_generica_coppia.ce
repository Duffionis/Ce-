//> 2.5
//> 1
//> 7
struttura Coppia<A, B> { primo: A, secondo: B }
funzione scambia<A, B>(c: Coppia<A, B>) -> Coppia<B, A> {
    ritorna Coppia { primo: c.secondo, secondo: c.primo };
}
funzione principale() -> intero {
    variabile c: Coppia<intero, doppio> = Coppia { primo: 1, secondo: 2.5 };
    variabile d: Coppia<doppio, intero> = scambia(c);
    stampa(d.primo);
    stampa(d.secondo);
    variabile e: Coppia<intero, Coppia<intero, intero>> = Coppia { primo: 3, secondo: Coppia { primo: 7, secondo: 8 } };
    stampa(e.secondo.primo);
    ritorna 0;
}
