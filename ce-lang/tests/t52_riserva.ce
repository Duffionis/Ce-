//> 5
//> 10
//> 0
struttura Punto { x: intero, y: intero }
funzione crea(n: dimensione) -> [intero] {
    variabile v: [intero] = riserva(intero, n);
    per i in 0..v.lunghezza {
        v[i] = (i come intero) * 2 + 2;
    }
    ritorna v;
}
funzione principale() -> intero {
    variabile v: [intero] = crea(5);
    rimanda { rischio { libera(v); } }
    stampa(v.lunghezza);
    stampa(v[4]);
    variabile p: [Punto] = riserva(Punto, 2);
    rimanda { rischio { libera(p); } }
    stampa(p[1].x);
    ritorna 0;
}
