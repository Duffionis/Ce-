//> 5
//> 99
//> 7
usa "../lib/opzione.ce";
funzione trova(v: [intero], x: intero) -> Opzione<dimensione> {
    per i in 0..v.lunghezza {
        se v[i] == x { ritorna qualcuno(i); }
    }
    ritorna nessuno();
}
funzione principale() -> intero {
    variabile o: Opzione<intero> = qualcuno(5);
    variabile v: Opzione<intero> = nessuno();
    stampa(valore_certo(o));
    stampa(v.valore_o(99));
    variabile a: [intero; 3] = [4, 7, 9];
    variabile r: Opzione<dimensione> = trova(a, 9);
    se r.c_e { stampa(a[1]); }
    ritorna 0;
}
