//> 1
struttura Stretta impacchettata { a: byte, b: naturale32, c: naturale16 }
struttura Larga { a: byte, b: naturale32, c: naturale16 }
funzione principale() -> intero {
    stampa(misura(Stretta));
    stampa(misura(Larga));
    variabile s: Stretta = Stretta { a: 1, b: 70000, c: 3 };
    stampa(s.a);
    ritorna 0;
}
