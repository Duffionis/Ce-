struttura Stretta impacchettata { a: u8, b: u32, c: u16 }
struttura Larga { a: u8, b: u32, c: u16 }
funzione principale() -> i32 {
    stampa(misura(Stretta));
    stampa(misura(Larga));
    variabile s: Stretta = Stretta { a: 1, b: 70000, c: 3 };
    stampa(s.a);
    ritorna 0;
}
