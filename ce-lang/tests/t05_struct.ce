//> 25
//> 6 4
//> 0 9
struttura Punto { x: intero, y: intero }
struttura Linea { a: Punto, b: Punto }
funzione lung2(l: Linea) -> intero {
    variabile dx: intero = l.b.x - l.a.x;
    variabile dy: intero = l.b.y - l.a.y;
    ritorna dx * dx + dy * dy;
}
funzione principale() -> intero {
    variabile l = Linea { a: Punto { x: 0, y: 0 }, b: Punto { x: 3, y: 4 } };
    stampa(lung2(l));
    l.b.x = 6;
    stampa(l.b.x, " ", l.b.y);
    variabile p: Punto = Punto { y: 9 };
    stampa(p.x, " ", p.y);
    ritorna 0;
}
