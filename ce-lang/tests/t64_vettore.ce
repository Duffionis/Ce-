//> 10
//> 45
//> 9
//> 0
usa "../lib/vettore.ce";
funzione principale() -> intero {
    variabile v: Vettore<intero> = Vettore { dati: riserva(intero, 0), n: 0 };
    per i in 0..10 {
        v.aggiungi(i);
    }
    variabile somma: intero = 0;
    per i in 0..v.n {
        somma += v.valore(i);
    }
    stampa(v.n);
    stampa(somma);
    stampa(v.valore(9));
    v.libera_vettore();
    stampa(v.n);
    ritorna 0;
}
