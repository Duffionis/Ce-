//> 2
//> 5
//> vero
//> 1000
//> 6
funzione principale() -> i32 {
    variabile r: Registro = Registro { modo: 5, attivo: vero, dato: 1000 };
    stampa(misura(Registro));
    stampa(r.modo);
    stampa(r.attivo);
    stampa(r.dato);
    r.modo = r.modo + 1;
    stampa(r.modo);
    ritorna 0;
}
struttura Registro impacchettata {
    modo: u8 : 3,
    attivo: booleano : 1,
    dato: u16 : 12,
}
