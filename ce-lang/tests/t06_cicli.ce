//> 15
//> 1 2 4 5
funzione principale() -> intero {
    variabile s: intero = 0;
    per i in 1..6 { s += i; }
    stampa(s);
    variabile k: intero = 0;
    mentre vero {
        k += 1;
        se k == 3 { continua; }
        se k > 5 { interrompi; }
        scrivi(k, " ");
    }
    stampa("");
    ritorna 0;
}
