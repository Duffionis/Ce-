//! tipo diverso: atteso intero, trovato bool
//! la funzione 'b' non ritorna un valore
//! 'ritorna' non e' permesso dentro 'rimanda'
//! 3 errori
funzione a() -> intero {
    variabile x: intero = vero;
    ritorna 0;
}
funzione b() -> intero {
    stampa("niente ritorno");
}
funzione c() -> intero {
    rimanda { ritorna 1; }
    ritorna 0;
}
funzione principale() -> intero { ritorna 0; }
