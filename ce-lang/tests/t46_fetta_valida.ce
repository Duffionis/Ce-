//> 3
//> 2
//> 7
//> ciao
struttura Voce { nome: testo, dati: [intero] }
funzione primi(x: [intero], n: dimensione) -> [intero] {
    variabile t: [intero] = x;
    ritorna t[0..n];
}
funzione crea(d: [intero]) -> Voce {
    ritorna Voce { nome: "ciao", dati: d };
}
funzione principale() -> intero {
    variabile a: [intero; 3] = [5, 6, 7];
    variabile v: [intero] = a[0..1];
    se vero {
        variabile b: [intero; 2] = [8, 9];
        variabile w: [intero] = b[0..1];
        w = a[1..3];
        stampa(w.lunghezza + 1);
    }
    v = a[0..3];
    stampa(primi(a, 2).lunghezza);
    variabile e: Voce = crea(a[0..3]);
    stampa(e.dati[2]);
    stampa(e.nome);
    ritorna 0;
}
