//> 3
//> 2
//> 7
//> ciao
struttura Voce { nome: testo, dati: [i32] }
funzione primi(x: [i32], n: usize) -> [i32] {
    variabile t: [i32] = x;
    ritorna t[0..n];
}
funzione crea(d: [i32]) -> Voce {
    ritorna Voce { nome: "ciao", dati: d };
}
funzione principale() -> i32 {
    variabile a: [i32; 3] = [5, 6, 7];
    variabile v: [i32] = a[0..1];
    se vero {
        variabile b: [i32; 2] = [8, 9];
        variabile w: [i32] = b[0..1];
        w = a[1..3];
        stampa(w.lunghezza + 1);
    }
    v = a[0..3];
    stampa(primi(a, 2).lunghezza);
    variabile e: Voce = crea(a[0..3]);
    stampa(e.dati[2]);
    stampa(e.nome);
    ritorna 0;
}
