//> 3
//> divisione per zero
usa "../lib/risultato.ce";
funzione dividi(a: intero, b: intero) -> Risultato<intero, testo> {
    se b == 0 { ritorna male("divisione per zero"); }
    ritorna bene(a / b);
}
funzione principale() -> intero {
    variabile r: Risultato<intero, testo> = dividi(6, 2);
    se r.riuscito { stampa(r.valore); } altrimenti { stampa(r.errore); }
    variabile q: Risultato<intero, testo> = dividi(6, 0);
    se q.riuscito { stampa(q.valore); } altrimenti { stampa(q.errore); }
    ritorna 0;
}
