//> 4
//> 3
struttura Punto { x: intero, y: intero }
funzione preferisci<T>(a: T, b: T, primo: booleano) -> T {
    se primo { ritorna a; }
    ritorna b;
}
funzione principale() -> intero {
    variabile p: Punto = Punto { x: 1, y: 2 };
    variabile q: Punto = Punto { x: 3, y: 4 };
    stampa(preferisci(p, q, falso).y);
    stampa(preferisci(p, q, vero).y + 1);
    ritorna 0;
}
