+    stampa(scegli(p, q, vero).y + 1);
+    ritorna 0;
+}
diff --git a/ce-lang/tests/t59_generica_riserva.ce b/ce-lang/tests/t59_generica_riserva.ce
new file mode 100644
index 0000000..ee41cd8
--- /dev/null
+++ b/ce-lang/tests/t59_generica_riserva.ce
@@ -0,0 +1,17 @@
+//> 20
+//> 3
+funzione copia<T>(v: [T]) -> [T] {
+    variabile c: [T] = riserva(T, v.lunghezza);
+    per i in 0..v.lunghezza {
+        c[i] = v[i];
+    }
+    ritorna c;
+}
+funzione principale() -> i32 {
+    variabile a: [i32; 3] = [10, 20, 30];
+    variabile c: [i32] = copia(a);
+    rimanda { rischio { libera(c); } }
+    stampa(c[1]);
+    stampa(c.lunghezza);
+    ritorna 0;
+}
