+funzione scegli<T>(a: T, b: T, primo: booleano) -> T {
+    se primo { ritorna a; }
+    ritorna b;
+}
+funzione principale() -> i32 {
+    variabile p: Punto = Punto { x: 1, y: 2 };
+    variabile q: Punto = Punto { x: 3, y: 4 };
