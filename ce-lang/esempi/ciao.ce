// Il mio primo programma Ce++
funzione somma(a: intero, b: intero) -> intero {
    ritorna a + b;
}

funzione principale() -> intero {
    variabile n: intero = 0xFF;
    per i in 0..5 {
        stampa("ciao ", i, " pi = ", 3.14);
    }
    /* commento
       su due righe */
    ritorna somma(n, 1);
}
