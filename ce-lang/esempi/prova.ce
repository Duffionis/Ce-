costante N: intero = 4;

struttura Punto { x: intero, y: intero }

esterna funzione puts(s: *carattere) -> intero;

funzione somma_tutti(v: [intero]) -> intero {
    variabile tot: intero = 0;
    per x in v { tot += x; }
    ritorna tot;
}

funzione principale() -> intero {
    variabile a: [intero; N] = [1, 2, 3, 4];
    variabile p = Punto { x: 1, y: -2 };
    se p.x < 2 && a[0] == 1 {
        stampa("ok ", somma_tutti(a[1..3]));
    } altrimenti se vero {
        stampa("altro");
    } altrimenti {
        ritorna 1;
    }
    mentre p.y < 0 { p.y += 1; interrompi; }
    rischio { puts("ciao" come *carattere); }
    ritorna (a[0] come lungo + 1) come intero;
}
