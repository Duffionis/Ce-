funzione principale() -> intero {
    variabile x: intero;
    stampa("x = ", x);
    variabile grande: intero = 2147483647;
    grande += 1;
    stampa("overflow: ", grande);
    variabile v: [intero; 3] = [10, 20, 30];
    variabile i: intero = 7;
    stampa("sto per leggere v[7]...");
    stampa(v[i]);
    ritorna 0;
}
