// Opzione<T>: un valore che puo' mancare (al posto di un valore speciale).
//
//   usa "lib/opzione.ce";
//   variabile o: Opzione<i32> = qualcuno(5);     // c'e'
//   variabile v: Opzione<i32> = nessuno();       // non c'e' (il tipo viene dalla dichiarazione)
//   se o.c_e { stampa(o.valore); }
//   stampa(o.valore_o(0));                        // valore, oppure 0 se manca
//   stampa(valore_certo(o));                      // panico se manca

struttura Opzione<T> {
    c_e: booleano,
    valore: T,
}

funzione qualcuno<T>(x: T) -> Opzione<T> {
    ritorna Opzione { c_e: vero, valore: x };
}

funzione nessuno<T>() -> Opzione<T> {
    variabile vuoto: T;
    ritorna Opzione { c_e: falso, valore: vuoto };
}

funzione valore_certo<T>(o: Opzione<T>) -> T {
    afferma(o.c_e, "valore_certo su un'opzione vuota");
    ritorna o.valore;
}

funzione valore_o<T>(o: Opzione<T>, altrimenti_questo: T) -> T {
    se o.c_e { ritorna o.valore; }
    ritorna altrimenti_questo;
}
