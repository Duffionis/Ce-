// Risultato<T, E>: o un valore (bene) o un errore (male). Niente panico.
//
//   usa "lib/risultato.ce";
//   funzione dividi(a: i32, b: i32) -> Risultato<i32, testo> {
//       se b == 0 { ritorna male("divisione per zero"); }
//       ritorna bene(a / b);
//   }
//   variabile r: Risultato<i32, testo> = dividi(6, 0);
//   se r.riuscito { stampa(r.valore); } altrimenti { stampa(r.errore); }
//
// 'bene(x)' e 'male(e)' prendono l'altro tipo da quello che il risultato deve essere.

struttura Risultato<T, E> {
    riuscito: booleano,
    valore: T,
    errore: E,
}

funzione bene<T, E>(x: T) -> Risultato<T, E> {
    variabile nessun_errore: E;
    ritorna Risultato { riuscito: vero, valore: x, errore: nessun_errore };
}

funzione male<T, E>(e: E) -> Risultato<T, E> {
    variabile nessun_valore: T;
    ritorna Risultato { riuscito: falso, valore: nessun_valore, errore: e };
}

funzione valore_certo_r<T, E>(r: Risultato<T, E>) -> T {
    afferma(r.riuscito, "valore_certo_r su un errore");
    ritorna r.valore;
}
