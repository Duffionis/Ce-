// Vettore<T>: array che cresce. Possiede memoria dell'heap (riserva/libera).
//
//   usa "lib/vettore.ce";
//   variabile v: Vettore<intero> = Vettore { dati: riserva(intero, 0), n: 0 };
//   v.aggiungi(5);
//   stampa(v.valore(0));
//   v.libera_vettore();
//
// 'v.aggiungi(5)' e' un altro modo di scrivere 'aggiungi(v, 5)'. Un
// parametro '&T' riceve la variabile stessa (la funzione puo' cambiarla).

struttura Vettore<T> {
    dati: [T],
    n: dimensione,
}

funzione aggiungi<T>(v: &Vettore<T>, x: T) {
    se v.n == v.dati.lunghezza {
        variabile nuovo: [T] = riserva(T, v.n * 2 + 4);
        per i in 0..v.n {
            nuovo[i] = v.dati[i];
        }
        variabile vecchio: [T] = v.dati;
        rischio { libera(vecchio); }
        v.dati = nuovo;
    }
    v.dati[v.n] = x;
    v.n += 1;
}

funzione valore<T>(v: Vettore<T>, i: dimensione) -> T {
    afferma(i < v.n, "indice fuori dal vettore");
    ritorna v.dati[i];
}

funzione libera_vettore<T>(v: &Vettore<T>) {
    variabile d: [T] = v.dati;
    rischio { libera(d); }
    v.dati = d;
    v.n = 0;
}
