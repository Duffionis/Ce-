// Mappa<K, V>: chiavi intere (intero, naturale64, ...) -> valori di qualsiasi tipo.
// Tabella hash con indirizzamento aperto; cresce da sola. Senza rimozione.
//
//   usa "lib/mappa.ce";
//   variabile m: Mappa<intero, intero> = nuova_mappa();
//   m.inserisci(7, 70);
//   variabile r: Opzione<intero> = m.cerca(7);       // c_e / valore
//   stampa(m.contiene(7));
//   m.libera_mappa();

usa "opzione.ce";

struttura Mappa<K, V> {
    chiavi: [K],
    valori: [V],
    pieno: [byte],
    n: dimensione,
}

funzione nuova_mappa<K, V>() -> Mappa<K, V> {
    ritorna Mappa { chiavi: riserva(K, 0), valori: riserva(V, 0), pieno: riserva(byte, 0), n: 0 };
}

funzione posto_di<K>(k: K, capacita: dimensione) -> dimensione {
    variabile h: naturale64 = (k come naturale64) * 11400714819323198485;
    h = h ^ (h >> 32);
    ritorna (h % (capacita come naturale64)) come dimensione;
}

// Mette k=v nelle tabelle date. Vero se la chiave e' nuova, falso se esisteva.
funzione posiziona<K, V>(chiavi: [K], valori: [V], pieno: [byte], k: K, v: V) -> booleano {
    variabile cap: dimensione = chiavi.lunghezza;
    variabile i: dimensione = posto_di(k, cap);
    mentre pieno[i] == 1 && chiavi[i] != k {
        i = (i + 1) % cap;
    }
    variabile nuova: booleano = pieno[i] == 0;
    pieno[i] = 1;
    chiavi[i] = k;
    valori[i] = v;
    ritorna nuova;
}

funzione cresci<K, V>(m: &Mappa<K, V>) {
    variabile cap: dimensione = m.chiavi.lunghezza * 2;
    se cap < 8 { cap = 8; }
    variabile nc: [K] = riserva(K, cap);
    variabile nv: [V] = riserva(V, cap);
    variabile np: [byte] = riserva(byte, cap);
    per i in 0..m.chiavi.lunghezza {
        se m.pieno[i] == 1 {
            posiziona(nc, nv, np, m.chiavi[i], m.valori[i]);
        }
    }
    variabile vc: [K] = m.chiavi;
    variabile vv: [V] = m.valori;
    variabile vp: [byte] = m.pieno;
    rischio { libera(vc); libera(vv); libera(vp); }
    m.chiavi = nc;
    m.valori = nv;
    m.pieno = np;
}

funzione inserisci<K, V>(m: &Mappa<K, V>, k: K, v: V) {
    se (m.n + 1) * 10 > m.chiavi.lunghezza * 7 {
        cresci(m);
    }
    se posiziona(m.chiavi, m.valori, m.pieno, k, v) {
        m.n += 1;
    }
}

funzione cerca<K, V>(m: Mappa<K, V>, k: K) -> Opzione<V> {
    se m.chiavi.lunghezza == 0 { ritorna nessuno<V>(); }
    variabile i: dimensione = posto_di(k, m.chiavi.lunghezza);
    mentre m.pieno[i] == 1 {
        se m.chiavi[i] == k { ritorna qualcuno(m.valori[i]); }
        i = (i + 1) % m.chiavi.lunghezza;
    }
    ritorna nessuno<V>();
}

funzione contiene<K, V>(m: Mappa<K, V>, k: K) -> booleano {
    ritorna cerca(m, k).c_e;
}

funzione libera_mappa<K, V>(m: &Mappa<K, V>) {
    variabile vc: [K] = m.chiavi;
    variabile vv: [V] = m.valori;
    variabile vp: [byte] = m.pieno;
    rischio { libera(vc); libera(vv); libera(vp); }
    m.chiavi = vc;
    m.valori = vv;
    m.pieno = vp;
    m.n = 0;
}
